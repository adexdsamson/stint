{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Manifest",
  "type": "object",
  "definitions": {
    "Identifier": {
      "title": "Identifier",
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "Agent": {
      "title": "Agent",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/Identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "required": ["id", "name"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "Publisher": {
      "title": "Publisher",
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/Identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "required": ["id", "name"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "Job": {
      "title": "Job",
      "type": "object",
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "verifier": { "$ref": "#/definitions/Verifier" }
      },
      "required": ["description", "verifier"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "Verifier": {
      "title": "Verifier",
      "oneOf": [
        { "$ref": "#/definitions/ResourceQueryVerifier" },
        { "$ref": "#/definitions/UserConfirmVerifier" },
        { "$ref": "#/definitions/NoneVerifier" }
      ]
    },
    "ResourceQueryVerifier": {
      "title": "ResourceQueryVerifier",
      "type": "object",
      "properties": {
        "type": { "const": "resource_query" },
        "resource": { "$ref": "#/definitions/Identifier" },
        "predicate": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "required": ["type", "resource", "predicate"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "UserConfirmVerifier": {
      "title": "UserConfirmVerifier",
      "type": "object",
      "properties": {
        "type": { "const": "user_confirm" },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 }
      },
      "required": ["type", "prompt"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "NoneVerifier": {
      "title": "NoneVerifier",
      "type": "object",
      "properties": {
        "type": { "const": "none" }
      },
      "required": ["type"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "Access": {
      "title": "Access",
      "type": "string",
      "enum": ["read", "write", "send", "pay"]
    },
    "Scope": {
      "title": "Scope",
      "type": "object",
      "properties": {
        "resource": { "$ref": "#/definitions/Identifier" },
        "access": {
          "type": "array",
          "items": { "$ref": "#/definitions/Access" },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        }
      },
      "required": ["resource", "access"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "Lease": {
      "title": "Lease",
      "type": "object",
      "properties": {
        "max_duration_seconds": { "type": "integer", "minimum": 1 }
      },
      "required": ["max_duration_seconds"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "Spend": {
      "title": "Spend",
      "type": "object",
      "properties": {
        "amount_minor": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      },
      "required": ["amount_minor", "currency"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "ErrorThreshold": {
      "title": "ErrorThreshold",
      "type": "object",
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "window_seconds": { "type": "integer", "minimum": 1 }
      },
      "required": ["count", "window_seconds"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "Limits": {
      "title": "Limits",
      "type": "object",
      "properties": {
        "max_actions": { "type": "integer", "minimum": 1 },
        "actions_per_hour": { "type": "integer", "minimum": 1 },
        "spend": { "$ref": "#/definitions/Spend" },
        "error_threshold": { "$ref": "#/definitions/ErrorThreshold" }
      },
      "required": ["max_actions"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "ApprovalTrigger": {
      "title": "ApprovalTrigger",
      "type": "string",
      "enum": ["send", "pay", "irreversible"]
    },
    "Approvals": {
      "title": "Approvals",
      "type": "object",
      "properties": {
        "require_for": {
          "type": "array",
          "items": { "$ref": "#/definitions/ApprovalTrigger" },
          "maxItems": 3,
          "uniqueItems": true
        },
        "timeout_seconds": { "type": "integer", "minimum": 1 }
      },
      "required": ["require_for", "timeout_seconds"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "AuthMode": {
      "title": "AuthMode",
      "type": "string",
      "enum": ["delegated", "hosted", "hybrid"]
    },
    "DelegatedGrant": {
      "title": "DelegatedGrant",
      "type": "object",
      "properties": {
        "provider": { "$ref": "#/definitions/Identifier" },
        "resources": {
          "type": "array",
          "items": { "$ref": "#/definitions/Identifier" },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": ["provider", "resources"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "HostedAuth": {
      "title": "HostedAuth",
      "type": "object",
      "properties": {
        "license_issuer": { "$ref": "#/definitions/Identifier" },
        "kid": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" }
      },
      "required": ["license_issuer"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "Auth": {
      "title": "Auth",
      "type": "object",
      "properties": {
        "mode": { "$ref": "#/definitions/AuthMode", "default": "hybrid" },
        "delegated": {
          "type": "array",
          "items": { "$ref": "#/definitions/DelegatedGrant" },
          "minItems": 1,
          "maxItems": 16
        },
        "hosted": { "$ref": "#/definitions/HostedAuth" }
      },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "PublisherRetains": {
      "title": "PublisherRetains",
      "type": "string",
      "enum": ["none", "aggregates", "job_outputs", "customer_data"]
    },
    "CleanupHook": {
      "title": "CleanupHook",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^(https://|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]{1,5})?(/|$))"
        }
      },
      "required": ["url"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "Cleanup": {
      "title": "Cleanup",
      "type": ["object", "null"],
      "properties": {
        "hook": { "$ref": "#/definitions/CleanupHook" },
        "publisher_retains": { "$ref": "#/definitions/PublisherRetains" }
      },
      "required": ["hook", "publisher_retains"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    }
  },
  "properties": {
    "spec_version": { "const": "alp/0.1" },
    "agent": { "$ref": "#/definitions/Agent" },
    "publisher": { "$ref": "#/definitions/Publisher" },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "job": { "$ref": "#/definitions/Job" },
    "scopes": {
      "type": "array",
      "items": { "$ref": "#/definitions/Scope" },
      "minItems": 1,
      "maxItems": 64
    },
    "lease": { "$ref": "#/definitions/Lease" },
    "limits": { "$ref": "#/definitions/Limits" },
    "approvals": { "$ref": "#/definitions/Approvals" },
    "auth": { "$ref": "#/definitions/Auth" },
    "cleanup": { "$ref": "#/definitions/Cleanup" }
  },
  "required": [
    "spec_version",
    "agent",
    "publisher",
    "version",
    "job",
    "scopes",
    "lease",
    "limits",
    "approvals",
    "auth",
    "cleanup"
  ],
  "patternProperties": { "^x-": {} },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "scopes": {
            "type": "array",
            "contains": {
              "type": "object",
              "properties": {
                "access": {
                  "type": "array",
                  "contains": { "const": "pay" }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "limits": {
            "type": "object",
            "properties": { "spend": {} },
            "required": ["spend"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "auth": {
            "type": "object",
            "properties": {
              "mode": { "enum": ["delegated", "hybrid"] }
            }
          }
        }
      },
      "then": {
        "properties": {
          "auth": {
            "type": "object",
            "properties": { "delegated": {} },
            "required": ["delegated"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "auth": {
            "type": "object",
            "properties": {
              "mode": { "enum": ["hosted", "hybrid"] }
            }
          }
        }
      },
      "then": {
        "properties": {
          "auth": {
            "type": "object",
            "properties": { "hosted": {} },
            "required": ["hosted"]
          }
        }
      }
    }
  ]
}
