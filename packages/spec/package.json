{
  "name": "@stint/spec",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "codegen": "node scripts/codegen.mjs",
    "codegen:check": "node scripts/codegen.mjs --check"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "json-schema-to-typescript": "16.0.0"
  }
}
